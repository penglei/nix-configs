{ lib, pkgs, username, ... }:

{
  imports = [
    ../nix.nix
    ../modules/configuration.nix
    ../modules/programs.nix
    ../modules/pam.nix
    ../modules/openssh.nix
    ../modules/sing-box-client.nix
    ./disko-config.nix
  ];

  boot.kernelModules = [ "wireguard" ];
  boot.initrd.availableKernelModules =
    [ "nvme" "virtio_pci" "xhci_pci" "usbhid" "virtiofs" ];

  # Use the systemd-boot EFI boot loader.
  boot.loader = {
    timeout = 1;
    systemd-boot.enable = true;
    efi.canTouchEfiVariables = true;
  };

  # fileSystems are generated by disko (partlabels: disk-main-esp / disk-main-root)

  # ssh RemoteForwards the local gpg-agent to /run/user/1000/gnupg/S.gpg-agent
  # (see ~/.ssh/config.d/localvms); sshd won't create the parent dir itself.
  users.users.${username}.uid = 1000;
  systemd.user.tmpfiles.users.${username}.rules = [ "d %t/gnupg 0700 - - -" ];

  #This is important for vscode server
  programs.nix-ld.enable = true;

  networking = { useDHCP = lib.mkDefault true; };
  environment.systemPackages = with pkgs; [ htop wireguard-tools fd ];
  services.timesyncd.enable = false;
  system.stateVersion = "23.11";
}
